        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "ox-committer": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "ox-explore": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "ox-researcher": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "ox-spec-auditor": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "ox-spec-exec": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "ox-spec-fix": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "max"
      }
    }
  },
  "quietStartup": true,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:pi-subagents@0.79.0\",\"scope\":\"user\"}": "0.79.0"
