{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "Gentleman-Sexy",
  "packages": [
    "npm:gentle-engram@0.3.0",
    "npm:pi-web-access",
    "npm:pi-btw",
    "npm:pi-subagents@0.89.2"
