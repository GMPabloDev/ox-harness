{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "ox-theme",
  "packages": [
    "npm:gentle-engram@0.3.0",
    "npm:pi-web-access",
    "npm:pi-btw",
    "npm:pi-subagents@0.79.0"
  ],
  "lastChangelogVersion": "1.6.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-terra",
  "modelThinkingLevels": {
    "openai-codex/gpt-6.1-terra": "medium",
    "openai-codex/gpt-6-luna": "max",
    "openai-codex/gpt-6.1-sol": "high"
  },
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna",
    "opencode-go/beam-free",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/longcat-2.5-preview-free",
    "opencode-go/minimax-m3.1-flash-free",
    "opencode-go/muse-spark-1.3-contributor",
    "opencode-go/mimo-v2.6-flash"
  ],
  "subagents": {
    "disableBuiltins": true,
    "agentOverrides": {
      "ox-scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "max"
      },
      "ox-researcher": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "max"
      },
      "ox-committer": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high"
      }
    }
  },
  "quietStartup": true,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:pi-subagents@0.79.0\",\"scope\":\"user\"}": "0.79.0"
  }
}